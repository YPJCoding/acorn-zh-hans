{
  "description": "Acorn 图像编辑软件核心术语基线与翻译准则",
  "version": "1.0.0",
  "rules": [
    "严格区分名词与动词上下文，例如 Select 是'选择'，Selection 是'选区'。",
    "不要混淆图层、图像与画布：Canvas 为'画布'，Image 为'图像'，Layer 为'图层'。",
    "保持占位符绝对一致：必须包含原文中所有的 %@、%d、%f、%1$@ 等 printf 标记，顺序与数量不可错乱。",
    "保留通用专业术语：如 sRGB、Display P3、ICC、LUT、RAW、DPI、PPI 等不翻译。",
    "标点符号适配：原文带英文冒号:或省略号...时，译文对应适配中文冒号：或省略号…；带快捷键后缀如 (Shift-C) 需原样保留。"
  ],
  "terms": {
    "Canvas": "画布",
    "Selection": "选区",
    "Select": "选择",
    "Deselect": "取消选择",
    "Inverse Selection": "反向选区",
    "Layer": "图层",
    "Layers": "图层",
    "Layer Mask": "图层蒙版",
    "Color Profile": "颜色描述文件",
    "Opacity": "不透明度",
    "Blend Mode": "混合模式",
    "Resample": "重采样",
    "Rasterize": "栅格化",
    "Flatten Image": "拼合图像",
    "Merge Layers": "合并图层",
    "Merge Visible": "合并可见图层",
    "Preset": "预设",
    "Crop": "裁剪",
    "Trim": "修边",
    "Export": "导出",
    "Inspector": "检查器",
    "Shape": "形状",
    "Vector": "矢量",
    "Anchor Point": "锚点",
    "Bezier": "贝塞尔",
    "Non-destructive": "非破坏性",
    "Levels": "色阶",
    "Curves": "曲线",
    "Threshold": "阈值",
    "Exposure": "曝光",
    "Vibrance": "自然饱和度",
    "Hue & Saturation": "色相与饱和度",
    "Sharpen": "锐化",
    "Blur": "模糊",
    "Gaussian Blur": "高斯模糊"
  }
}
